generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id_aluno               Int      @id @default(autoincrement())
  nome                   String   @map("nome") @db.VarChar(250)
  data_nascimento        DateTime @map("data_nascimento") @db.Date
  cpf                    String   @unique @map("cpf") @db.VarChar(11)
  rg                     String   @unique @map("rg") @db.VarChar(11)
  nis                    String   @unique @map("nis") @db.VarChar(11)
  cep                    String   @map("cep") @db.VarChar(8)
  bairro                 String   @map("bairro") @db.VarChar(30)
  rua                    String   @map("rua") @db.VarChar(80)
  numero_casa            String   @map("numero_casa") @db.VarChar(5)
  nome_mae               String   @map("nome_mae") @db.VarChar(250)
  telefone               String   @map("telefone") @db.VarChar(15)
  grupo_scfv             Int      @map("grupo_scfv")
  situacao_escolar       Int      @map("situacao_escolar")
  alergias               String?  @map("alergias") @db.VarChar(100)
  necessidades_especiais String?  @map("necessidades_especiais") @db.VarChar(120)
  medicamentos           String?  @map("medicamentos") @db.VarChar(200)
  ativo                  Boolean  @map("ativo")

  programaSocial ProgramaSocial[]
  diarios                Diario[]

  @@map("aluno")
}

model ProgramaSocial {
  id_programa_social Int    @id @default(autoincrement())
  nome               String @map("nome") @db.VarChar(300) @unique

  alunos Aluno[]

  @@map("programa_social")
}

model Funcionario {
  id_funcionario Int     @id @default(autoincrement())
  id_perfil      Int     @map("id_perfil")
  nome           String  @map("nome") @db.VarChar(250)
  email          String  @unique @map("email") @db.VarChar(60)
  senha          String  @map("senha") @db.VarChar(100)
  telefone       String  @map("telefone") @db.VarChar(15)
  ativo          Boolean @map("ativo")

  perfil         Perfil      @relation(fields: [id_perfil], references: [id_perfil])
  Sessao         Sessao[]
  oficinas       Oficina[]
  diarios        Diario[]
  tokens         Token[]  
  @@map("funcionario")
}

model Token {
  id_token     Int          @id @default(autoincrement())
  valor        String       @db.VarChar(255) @unique 
  tipo         String       @db.VarChar(50)
  usado_em     DateTime?
  ativo        Boolean      @default(true)
  funcionarioId Int
  funcionario  Funcionario  @relation(fields: [funcionarioId], references: [id_funcionario])
}
enum TokenTipo {
  primeiro_acesso
  redefinicao_senha
}

model Perfil {
  id_perfil Int    @id @default(autoincrement()) @map("id_perfil")
  nome      String @map("nome") @db.VarChar(300) @unique

  funcionarios Funcionario[]

  @@map("perfil")
}

model Sessao {
  id_sessao      String   @id @map("id_sessao")
  id_funcionario Int      @map("id_funcionario")
  ativo          Boolean  @map("ativo")
  data_criacao   DateTime @map("data_criacao")
  token          String   @map("token") @db.MediumText

  token_funcionario Funcionario @relation(fields: [id_funcionario], references: [id_funcionario])

  @@map("sessao")
}

model Oficina {
  id_oficina     Int          @id @default(autoincrement())
  id_funcionario Int
  nome           String       @db.VarChar(50) @unique
  descricao      String       @db.VarChar(300)
  status         Boolean      @db.TinyInt
  funcionario    Funcionario  @relation(fields: [id_funcionario], references: [id_funcionario])
  cronograma     OficinaCronograma[]
  criado_em      DateTime     @default(now())
  atualizado_em  DateTime     @updatedAt
  excluido_em    DateTime?
  diarios        Diario[] 

  @@map("oficina")
}

model OficinaCronograma {
  id_oficina     Int
  dia            Int
  hora_inicio    DateTime @db.Time(0)
  hora_fim       DateTime @db.Time(0)
  oficina        Oficina  @relation(fields: [id_oficina], references: [id_oficina], onDelete: Cascade)
  

  @@map("oficina_dias")
  @@unique([id_oficina, dia], name: "id_oficina_cronograma")
}

model Diario {
  @@map("diario")

  id_diario     Int          @id @default(autoincrement()) @map("id_diario")
  id_aluno      Int          @map("id_aluno")
  id_oficina    Int?         @map("id_oficina")
  id_autor      Int          @map("id_autor")

  conteudo      String       @db.VarChar(300) @map("conteudo")
  
  criado_em     DateTime     @default(now())       
  atualizado_em DateTime     @updatedAt            
  excluido_em   DateTime?                          

  autor         Funcionario  @relation(fields: [id_autor], references: [id_funcionario])
  aluno         Aluno        @relation(fields: [id_aluno], references: [id_aluno])
  oficina       Oficina?     @relation(fields: [id_oficina], references: [id_oficina]) //  reativado relacionamento
}
